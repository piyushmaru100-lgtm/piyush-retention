{
  "name": "piyushretention",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "piyushretention-db",
      "database_id": "9aab1bb1-1c05-456f-becb-cfd0426b63b2"
    }
  ]
}
